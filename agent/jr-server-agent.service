[Unit]
Description=JR Server Remote Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/jr-server-agent.env
ExecStart=/usr/bin/python3 /usr/local/sbin/jr-server-agent
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/proc /sys
MemoryMax=96M

[Install]
WantedBy=multi-user.target
