#!/bin/sh
set -eu
BASE=/home/jorge/backups-jr
SCRIPT=/home/jorge/backup-jr.sh
case "${1:-}" in
  list)
    [ -d "$BASE" ] || exit 0
    find "$BASE" -type f \( -name '*.sql' -o -name '*.sql.gz' -o -name '*.tar.gz' -o -name '*.tgz' -o -name '*.zip' -o -name '*.txt' -o -name '*.json' \) -printf '%T@\t%s\t%p\n' 2>/dev/null | sort -nr | head -100
    ;;
  usage)
    [ -d "$BASE" ] || { printf '0\t0\n'; exit 0; }
    bytes=$(du -sb "$BASE" 2>/dev/null | awk '{print $1}')
    count=$(find "$BASE" -type f 2>/dev/null | wc -l)
    printf '%s\t%s\n' "${bytes:-0}" "${count:-0}"
    ;;
  status)
    latest=$(find "$BASE/automaticos" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -r | head -1 || true)
    [ -n "$latest" ] || { printf 'latest=\ndatabase=0\nproject=0\npanel=0\nserver=0\ncomplete=0\nremote=0\n'; exit 0; }
    dir="$BASE/automaticos/$latest"
    [ -s "$dir/database/jr_electricidad.sql" ] && database=1 || database=0
    [ -d "$dir/proyecto/jrelectricidad1" ] && [ "$(find "$dir/proyecto/jrelectricidad1" -mindepth 1 -print -quit 2>/dev/null)" ] && project=1 || project=0
    [ -d "$dir/jr-server-panel" ] && [ "$(find "$dir/jr-server-panel" -mindepth 1 -print -quit 2>/dev/null)" ] && panel=1 || panel=0
    [ -d "$dir/servidor/nginx" ] && [ -s "$dir/servidor/info/pm2-processes.json" ] && server=1 || server=0
    [ -f "$dir/COMPLETE" ] && complete=1 || complete=0
    remote=0
    if command -v rclone >/dev/null 2>&1 && [ -f /home/jorge/.config/rclone/rclone.conf ]; then
      rclone --config /home/jorge/.config/rclone/rclone.conf lsf "backblaze-crypt:JR-ELECTRICIDAD/AUTOMATICOS/$latest/" --max-depth 1 >/dev/null 2>&1 && remote=1 || true
    fi
    printf 'latest=%s\ndatabase=%s\nproject=%s\npanel=%s\nserver=%s\ncomplete=%s\nremote=%s\n' "$latest" "$database" "$project" "$panel" "$server" "$complete" "$remote"
    ;;
  script-status)
    if [ -f "$SCRIPT" ]; then
      stat -c '%a|%U|%G|%Y|%s' "$SCRIPT"
    else
      printf 'missing\n'
    fi
    ;;
  run)
    [ -f "$SCRIPT" ] || { echo 'backup_script_missing' >&2; exit 2; }
    [ -x "$SCRIPT" ] || { echo 'backup_script_not_executable' >&2; exit 3; }
    exec "$SCRIPT"
    ;;
  *)
    echo "Accion no permitida" >&2
    exit 64
    ;;
esac
