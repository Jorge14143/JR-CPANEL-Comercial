#!/usr/bin/env python3
import json, os, socket, subprocess, time, urllib.request

PANEL=os.environ.get("JR_AGENT_PANEL","").rstrip("/")
TOKEN=os.environ.get("JR_AGENT_TOKEN","")
INTERVAL=max(15,int(os.environ.get("JR_AGENT_INTERVAL","30")))

def sh(*args):
    try:return subprocess.check_output(args,text=True,stderr=subprocess.DEVNULL,timeout=8).strip()
    except:return ""

def cpu():
    def snap():
        v=open("/proc/stat").readline().split()[1:];n=list(map(int,v));return sum(n),n[3]+(n[4] if len(n)>4 else 0)
    a,i=snap();time.sleep(.25);b,j=snap();return round(100*(1-(j-i)/max(1,b-a)))

_net_prev=None

def network_metrics():
    global _net_prev
    now=time.time();stats={}
    try:
        for line in open("/proc/net/dev").read().splitlines()[2:]:
            if ":" not in line:continue
            name,raw=line.split(":",1);name=name.strip()
            if name=="lo":continue
            fields=raw.split()
            if len(fields)>=16:stats[name]=(int(fields[0]),int(fields[8]))
    except:return {"interface":"--","rxPerSec":0,"txPerSec":0,"rxBytes":0,"txBytes":0}
    if not stats:return {"interface":"--","rxPerSec":0,"txPerSec":0,"rxBytes":0,"txBytes":0}
    route=sh("ip","route","show","default").split()
    preferred=route[route.index("dev")+1] if "dev" in route and route.index("dev")+1<len(route) else None
    iface=preferred if preferred in stats else max(stats,key=lambda x:sum(stats[x]))
    rx,tx=stats[iface];rxps=txps=0
    if _net_prev and _net_prev[0]==iface:
        elapsed=max(.001,now-_net_prev[1]);rxps=max(0,round((rx-_net_prev[2])/elapsed));txps=max(0,round((tx-_net_prev[3])/elapsed))
    _net_prev=(iface,now,rx,tx)
    return {"interface":iface,"rxPerSec":rxps,"txPerSec":txps,"rxBytes":rx,"txBytes":tx}

def metrics():
    mem={k:int(v.split()[0]) for k,v in (line.split(":",1) for line in open("/proc/meminfo")) if k in ("MemTotal","MemAvailable")}
    st=os.statvfs("/");total=st.f_blocks*st.f_frsize;free=st.f_bavail*st.f_frsize
    temp=None
    try:
        vals=[]
        for d in os.listdir("/sys/class/thermal"):
            p=os.path.join("/sys/class/thermal",d,"temp")
            if os.path.exists(p):
                v=float(open(p).read().strip())/1000
                if 0<v<150:vals.append(v)
        if vals:temp=round(max(vals),1)
    except:pass
    return {"cpuPercent":cpu(),"memoryPercent":round(100*(1-mem["MemAvailable"]/mem["MemTotal"])),"diskPercent":round(100*(1-free/max(1,total))),"temperature":temp,"uptime":int(float(open("/proc/uptime").read().split()[0])),"network":network_metrics()}

def service_is_relevant(unit,name,desc):
    # Discovery stays dynamic: this is a generic noise filter, not a catalog
    # of products such as Apache/Nginx/MySQL. New application services can
    # appear without updating the agent.
    n=name.lower();d=desc.lower()
    noise_prefixes=("systemd-","getty","serial-getty","dbus","user@","polkit","rsyslog","journald","udev","logind","console-","keyboard-setup","kmod","modprobe","plymouth","procps","hwclock","ifupdown-","cron","qemu-guest-agent")
    if n.startswith(noise_prefixes):return False
    noise_words=("login service","device event","journal service","message bus","authorization manager","virtual console","kernel module","userspace out-of-memory")
    if any(x in d for x in noise_words):return False
    # Keep enabled/persistent units and application/daemon-like services.
    enabled=sh("systemctl","is-enabled",unit)
    if enabled in ("enabled","enabled-runtime","static","indirect","generated"):return True
    app_words=("server","daemon","agent","database","web","proxy","container","docker","podman","ssh","vpn","dns","backup","monitor","apache","nginx","redis","postgres","mysql","maria","php","node","cloud","fail2ban","firewall","samba","ftp")
    return any(x in n or x in d for x in app_words)

def services():
    raw=sh("systemctl","list-units","--type=service","--state=running","--no-legend","--no-pager","--plain")
    out=[];seen=set()
    for line in raw.splitlines():
        parts=line.split(None,4)
        if not parts:continue
        unit=parts[0]
        if not unit.endswith(".service"):continue
        name=unit[:-8]
        if name in seen:continue
        seen.add(name)
        desc=sh("systemctl","show",unit,"-p","Description","--value") or name
        if not service_is_relevant(unit,name,desc):continue
        enabled=sh("systemctl","is-enabled",unit) or "unknown"
        out.append({"name":name,"label":desc,"unit":unit,"state":"active","active":True,"enabled":enabled})
    return sorted(out,key=lambda x:x["label"].lower())

def send():
    body=json.dumps({"hostname":socket.gethostname(),"metrics":metrics(),"services":services()}).encode()
    req=urllib.request.Request(PANEL+"/api/agent/v1/checkin",data=body,headers={"Authorization":"Bearer "+TOKEN,"Content-Type":"application/json","Accept":"application/json","User-Agent":"JR-Server-Agent/1.1"},method="POST")
    with urllib.request.urlopen(req,timeout=10) as r:r.read()

if not PANEL.startswith("https://") or not TOKEN:raise SystemExit("JR_AGENT_PANEL/JR_AGENT_TOKEN faltan")
while True:
    try:send()
    except Exception as e:print("checkin:",e,flush=True)
    time.sleep(INTERVAL)
