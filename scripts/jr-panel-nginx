#!/bin/sh
set -eu
case "${1:-}" in
  test)
    exec /usr/sbin/nginx -t
    ;;
  reload)
    /usr/sbin/nginx -t
    exec /usr/bin/systemctl reload nginx
    ;;
  access-log)
    exec /usr/bin/tail -n 80 /var/log/nginx/access.log
    ;;
  error-log)
    exec /usr/bin/tail -n 80 /var/log/nginx/error.log
    ;;
  request-count)
    exec /usr/bin/wc -l /var/log/nginx/access.log
    ;;
  *)
    echo "Accion no permitida" >&2
    exit 64
    ;;
esac
