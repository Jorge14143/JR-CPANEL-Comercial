#!/bin/sh
set -eu
ACTION="${1:-list}"
VM="${2:-}"

need_vm() {
  [ -n "$VM" ] || { echo "missing_vm" >&2; exit 2; }
  printf '%s' "$VM" | grep -Eq '^[A-Za-z0-9._-]+$' || { echo "invalid_vm" >&2; exit 2; }
  /usr/bin/virsh dominfo "$VM" >/dev/null 2>&1 || { echo "vm_not_found" >&2; exit 3; }
}

slot_device() {
  case "${1:-}" in
    1) echo /dev/sdb1 ;;
    2) echo /dev/sdb2 ;;
    3) echo /dev/sdb3 ;;
    4) echo /dev/sdb4 ;;
    *) echo "invalid_slot" >&2; exit 2 ;;
  esac
}

slot_used_by() {
  DEV="$1"
  for N in $(/usr/bin/virsh list --all --name | sed '/^$/d'); do
    if /usr/bin/virsh dumpxml "$N" 2>/dev/null | /usr/bin/grep -Fq "dev='$DEV'"; then
      echo "$N"
      return 0
    fi
  done
  return 1
}

case "$ACTION" in
  list)
    /usr/bin/virsh list --all --name | sed '/^$/d'
    ;;
  info)
    need_vm
    /usr/bin/virsh dominfo "$VM"
    ;;
  uptime)
    need_vm

    STATE=$(/usr/bin/virsh domstate "$VM" 2>/dev/null || true)

    if [ "$STATE" != "running" ]; then
      echo 0
      exit 0
    fi

    PIDFILE="/run/libvirt/qemu/${VM}.pid"

    if [ ! -r "$PIDFILE" ]; then
      echo 0
      exit 0
    fi

    PID=$(/usr/bin/cat "$PIDFILE" 2>/dev/null || true)

    if ! printf '%s' "$PID" | /usr/bin/grep -Eq '^[0-9]+$'; then
      echo 0
      exit 0
    fi

    /usr/bin/ps -p "$PID" -o etimes= 2>/dev/null |
      /usr/bin/tr -d ' '
    ;;

  mac)
    need_vm
    /usr/bin/virsh domiflist "$VM" 2>/dev/null |
      /usr/bin/awk 'NR>2 && $5 ~ /^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$/ {print tolower($5); exit}'
    ;;

  domstats)
    need_vm
    /usr/bin/virsh domstats "$VM" --balloon --vcpu --block --interface
    ;;
  vnc)
    need_vm
    /usr/bin/virsh vncdisplay "$VM"
    ;;
  ip)
    need_vm

    # Primero intenta leases administrados por libvirt (NAT/default).
    OUT=$(/usr/bin/virsh domifaddr "$VM" --source lease 2>/dev/null || true)
    printf '%s\n' "$OUT"

    # Las VM conectadas a br0 reciben DHCP directamente del router.
    # Si libvirt no conoce la IP, buscamos la MAC de la VM en la tabla ARP.
    if ! printf '%s\n' "$OUT" | /usr/bin/grep -Eq '([0-9]{1,3}\.){3}[0-9]{1,3}/'; then
      MAC=$(/usr/bin/virsh domiflist "$VM" 2>/dev/null | /usr/bin/awk 'NR>2 && $5 ~ /^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$/ {print tolower($5); exit}')
      if [ -n "$MAC" ]; then
        IP=$(/usr/sbin/ip neigh show dev br0 2>/dev/null | /usr/bin/awk -v mac="$MAC" 'tolower($3)==mac && $1 ~ /^[0-9]+\./ {print $1; exit}')
        if [ -n "$IP" ]; then
          printf ' br0        %s    ipv4         %s/24\n' "$MAC" "$IP"
        fi
      fi
    fi
    ;;
  iso-import)
    SRC="${2:-}"
    NAME="${3:-}"
    case "$SRC" in /tmp/jr-vm-*.iso) ;; *) echo "invalid_iso_source" >&2; exit 2 ;; esac
    [ -f "$SRC" ] || { echo "iso_source_missing" >&2; exit 2; }
    printf '%s' "$NAME" | grep -Eqi '^[A-Za-z0-9._ -]+\.iso$' || { echo "invalid_iso_name" >&2; exit 2; }
    /usr/bin/install -o root -g libvirt -m 0640 "$SRC" "/var/lib/libvirt/images/$NAME"
    /usr/bin/rm -f "$SRC"
    ;;
  iso-download)
    URL="${2:-}"
    NAME="${3:-}"
    case "$URL" in https://*) ;; *) echo "only_https_allowed" >&2; exit 2 ;; esac
    printf '%s' "$NAME" | grep -Eqi '^[A-Za-z0-9._ -]+\.iso$' || { echo "invalid_iso_name" >&2; exit 2; }
    /usr/bin/curl --proto '=https' --proto-redir '=https' -fL --retry 3 --connect-timeout 20 -o "/var/lib/libvirt/images/$NAME.part" "$URL"
    /usr/bin/mv "/var/lib/libvirt/images/$NAME.part" "/var/lib/libvirt/images/$NAME"
    /usr/bin/chown root:libvirt "/var/lib/libvirt/images/$NAME"
    /usr/bin/chmod 0640 "/var/lib/libvirt/images/$NAME"
    echo "/var/lib/libvirt/images/$NAME"
    ;;
  iso-list)
    /usr/bin/find /srv/proyectos/jr-server-panel/sistemas-operativos -maxdepth 3 -type f -iname '*.iso' -printf '%p\n' 2>/dev/null | /usr/bin/sort
    ;;
  iso-delete)
    ISO="${2:-}"
    case "$ISO" in /var/lib/libvirt/images/*.iso) ;; *) echo "invalid_iso_path" >&2; exit 2 ;; esac
    [ -f "$ISO" ] || { echo "iso_not_found" >&2; exit 3; }
    /usr/bin/rm -- "$ISO"
    ;;
  slots)
    for S in 1 2 3 4; do
      DEV=$(slot_device "$S")
      USED=$(slot_used_by "$DEV" || true)
      printf '%s\t%s\t%s\n' "$S" "$DEV" "$USED"
    done
    ;;
  create)
    NAME="${2:-}"; VCPUS="${3:-}"; RAM="${4:-}"; SLOT="${5:-}"; ISO="${6:-}"; AUTOSTART="${7:-off}"
    printf '%s' "$NAME" | grep -Eq '^[A-Za-z0-9._-]{1,64}$' || { echo "invalid_name" >&2; exit 2; }
    printf '%s' "$VCPUS" | grep -Eq '^[1-4]$' || { echo "invalid_vcpus" >&2; exit 2; }
    printf '%s' "$RAM" | grep -Eq '^[0-9]+$' || { echo "invalid_ram" >&2; exit 2; }
    [ "$RAM" -ge 512 ] && [ "$RAM" -le 8192 ] || { echo "invalid_ram" >&2; exit 2; }
    DEV=$(slot_device "$SLOT")
    [ -b "$DEV" ] || { echo "slot_device_missing" >&2; exit 3; }
    USED=$(slot_used_by "$DEV" || true)
    [ -z "$USED" ] || { echo "slot_in_use:$USED" >&2; exit 3; }
    [ -f "$ISO" ] || { echo "iso_not_found" >&2; exit 2; }
    case "$ISO" in /srv/proyectos/jr-server-panel/sistemas-operativos/*.iso) ;; *) echo "invalid_iso_path" >&2; exit 2 ;; esac
    /usr/bin/virsh dominfo "$NAME" >/dev/null 2>&1 && { echo "vm_exists" >&2; exit 3; } || true
    /usr/bin/virt-install --name "$NAME" --vcpus "$VCPUS" --memory "$RAM" --disk "path=$DEV,format=raw,bus=virtio" --cdrom "$ISO" --network bridge=br0,model=virtio --graphics vnc,listen=127.0.0.1 --video virtio --osinfo ubuntu25.10 --noautoconsole --boot cdrom,hd
    [ "$AUTOSTART" = "on" ] && /usr/bin/virsh autostart "$NAME" || true
    ;;
  console-sync)
    TMP=$(/usr/bin/mktemp)
    /usr/bin/virsh list --name | /usr/bin/sed '/^$/d' | while IFS= read -r N; do
      printf '%s' "$N" | /usr/bin/grep -Eq '^[A-Za-z0-9._-]+$' || continue
      DISPLAY=$(/usr/bin/virsh vncdisplay "$N" 2>/dev/null || true)
      [ -n "$DISPLAY" ] || continue
      NUM=${DISPLAY##*:}
      printf '%s' "$NUM" | /usr/bin/grep -Eq '^[0-9]+$' || continue
      PORT=$((5900 + NUM))
      printf '%s: 127.0.0.1:%s\n' "$N" "$PORT" >> "$TMP"
    done
    /usr/bin/install -o root -g jorge -m 0640 "$TMP" /etc/jr-server-panel/vnc-tokens
    /usr/bin/rm -f "$TMP"
    /usr/bin/cat /etc/jr-server-panel/vnc-tokens
    ;;
  eject-iso)
    need_vm


    /usr/bin/virsh domblklist "$VM" --details 2>/dev/null |
    /usr/bin/awk '$2=="cdrom" && $4!="-" {print $3}' |
    while IFS= read -r TARGET; do
      [ -n "$TARGET" ] || continue

      # Quita el medio de la VM activa, si está encendida.
      STATE=$(/usr/bin/virsh domstate "$VM" 2>/dev/null || true)
      case "$STATE" in
        running|paused|"in shutdown")
          /usr/bin/virsh change-media "$VM" "$TARGET" --eject --live 2>/dev/null || true
          ;;
      esac

      # Y también de la configuración persistente.
      /usr/bin/virsh change-media "$VM" "$TARGET" --eject --config 2>/dev/null || true

      printf 'ejected:%s\n' "$TARGET"
    done

    # Acción idempotente: si ya no hay ISO, no se considera error.
    exit 0
    ;;
  backup-list)
    need_vm
    DIR="/srv/vm-backups/$VM"
    [ -d "$DIR" ] || exit 0
    for D in "$DIR"/*; do
      [ -d "$D" ] || continue
      ID=${D##*/}
      if [ -f "$D/COMPLETE" ]; then STATUS=complete; else STATUS=incomplete; fi
      SIZE=$(/usr/bin/du -sh "$D" 2>/dev/null | /usr/bin/awk '{print $1}')
      printf '%s\t%s\t%s\n' "$ID" "$STATUS" "${SIZE:-0}"
    done | /usr/bin/sort -r
    ;;
  backup-create)
    need_vm
    STATE=$(/usr/bin/virsh domstate "$VM" 2>/dev/null || true)
    [ "$STATE" != "running" ] && [ "$STATE" != "paused" ] && [ "$STATE" != "in shutdown" ] || { echo "vm_must_be_stopped" >&2; exit 4; }
    DEV=$(/usr/bin/virsh domblklist "$VM" --details 2>/dev/null | /usr/bin/awk '$1=="block" && $2=="disk" {print $4; exit}')
    case "$DEV" in /dev/sdb[1-4]) ;; *) echo "unsupported_vm_disk" >&2; exit 5 ;; esac
    AVAIL=$(/usr/bin/df -Pk /srv/vm-backups | /usr/bin/awk 'NR==2 {print $4}')
    [ "${AVAIL:-0}" -ge 4194304 ] || { echo "not_enough_backup_space" >&2; exit 6; }
    TS=$(/usr/bin/date '+%Y-%m-%d_%H-%M-%S'); DIR="/srv/vm-backups/$VM/$TS"; TMP="/mnt/jr-vm-backup-$$"
    /usr/bin/mkdir -p "$DIR" "$TMP"
    cleanup(){ /usr/bin/umount "$TMP" 2>/dev/null || true; [ -n "${LOOP:-}" ] && /usr/sbin/losetup -d "$LOOP" 2>/dev/null || true; }
    trap cleanup EXIT INT TERM
    /usr/bin/virsh dumpxml "$VM" > "$DIR/vm.xml"
    /usr/sbin/sfdisk -d "$DEV" > "$DIR/partition-table.sfdisk"
    /usr/bin/dd if="$DEV" of="$DIR/boot.bin" bs=512 count=2048 status=none
    LOOP=$(/usr/sbin/losetup --find --show --partscan "$DEV")
    [ -b "${LOOP}p1" ] || { echo "linux_partition_not_found" >&2; exit 7; }
    /usr/bin/mount -o ro,noload "${LOOP}p1" "$TMP"
    ROOT_UUID=$(/usr/sbin/blkid -s UUID -o value "${LOOP}p1" 2>/dev/null || true)
    SWAP_UUID=""; [ -b "${LOOP}p5" ] && SWAP_UUID=$(/usr/sbin/blkid -s UUID -o value "${LOOP}p5" 2>/dev/null || true)
    [ -n "$ROOT_UUID" ] || { echo "root_uuid_not_found" >&2; exit 8; }
    printf 'ROOT_UUID=%s\nSWAP_UUID=%s\n' "$ROOT_UUID" "$SWAP_UUID" > "$DIR/filesystem-uuids"
    /usr/bin/tar --one-file-system --numeric-owner --xattrs --acls -C "$TMP" -cpf - . | /usr/bin/gzip -1 > "$DIR/rootfs.tar.gz"
    /usr/bin/umount "$TMP"; /usr/sbin/losetup -d "$LOOP"; LOOP=""
    /usr/bin/touch "$DIR/COMPLETE"; /usr/bin/sync
    echo "$TS"
    ;;
  backup-delete)
    need_vm
    ID="${3:-}"; printf '%s' "$ID" | /usr/bin/grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$' || { echo "invalid_backup" >&2; exit 2; }
    DIR="/srv/vm-backups/$VM/$ID"; [ -d "$DIR" ] || { echo "backup_not_found" >&2; exit 3; }; /usr/bin/rm -rf -- "$DIR"
    ;;
  backup-restore)
    need_vm
    STATE=$(/usr/bin/virsh domstate "$VM" 2>/dev/null || true)
    [ "$STATE" != "running" ] && [ "$STATE" != "paused" ] && [ "$STATE" != "in shutdown" ] || { echo "vm_must_be_stopped" >&2; exit 4; }
    ID="${3:-}"; printf '%s' "$ID" | /usr/bin/grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$' || { echo "invalid_backup" >&2; exit 2; }
    DIR="/srv/vm-backups/$VM/$ID"; [ -f "$DIR/COMPLETE" ] && [ -f "$DIR/rootfs.tar.gz" ] && [ -f "$DIR/partition-table.sfdisk" ] || { echo "backup_incomplete" >&2; exit 3; }
    DEV=$(/usr/bin/virsh domblklist "$VM" --details 2>/dev/null | /usr/bin/awk '$1=="block" && $2=="disk" {print $4; exit}'); case "$DEV" in /dev/sdb[1-4]) ;; *) echo "unsupported_vm_disk" >&2; exit 5 ;; esac
    /usr/sbin/sfdisk "$DEV" < "$DIR/partition-table.sfdisk"; /usr/bin/dd if="$DIR/boot.bin" of="$DEV" bs=512 count=2048 conv=notrunc status=none; /usr/sbin/partprobe "$DEV" || true
    LOOP=$(/usr/sbin/losetup --find --show --partscan "$DEV"); TMP="/mnt/jr-vm-restore-$$"; /usr/bin/mkdir -p "$TMP"
    cleanup(){ /usr/bin/umount "$TMP" 2>/dev/null || true; [ -n "${LOOP:-}" ] && /usr/sbin/losetup -d "$LOOP" 2>/dev/null || true; }; trap cleanup EXIT INT TERM
    ROOT_UUID=""; SWAP_UUID=""
    if [ -f "$DIR/filesystem-uuids" ]; then
      ROOT_UUID=$(/usr/bin/sed -n 's/^ROOT_UUID=//p' "$DIR/filesystem-uuids" | /usr/bin/head -n1)
      SWAP_UUID=$(/usr/bin/sed -n 's/^SWAP_UUID=//p' "$DIR/filesystem-uuids" | /usr/bin/head -n1)
    else
      # Compatibilidad con backups creados antes de guardar filesystem-uuids.
      ROOT_UUID=$(/usr/bin/gzip -dc "$DIR/rootfs.tar.gz" | /usr/bin/tar -xOf - ./etc/fstab 2>/dev/null | /usr/bin/awk '$2=="/" && $1 ~ /^UUID=/ {sub(/^UUID=/,"",$1); print $1; exit}' || true)
      SWAP_UUID=$(/usr/bin/gzip -dc "$DIR/rootfs.tar.gz" | /usr/bin/tar -xOf - ./etc/fstab 2>/dev/null | /usr/bin/awk '$3=="swap" && $1 ~ /^UUID=/ {sub(/^UUID=/,"",$1); print $1; exit}' || true)
    fi
    printf '%s' "$ROOT_UUID" | /usr/bin/grep -Eq '^[0-9a-fA-F-]{36}
    ;;
  start) need_vm; exec /usr/bin/virsh start "$VM" ;;
  shutdown) need_vm; exec /usr/bin/virsh shutdown "$VM" ;;
  reboot) need_vm; exec /usr/bin/virsh reboot "$VM" ;;
  destroy) need_vm; exec /usr/bin/virsh destroy "$VM" ;;
  delete)
    need_vm
    STATE=$(/usr/bin/virsh domstate "$VM" 2>/dev/null || true)
    [ "$STATE" != "running" ] && [ "$STATE" != "paused" ] && [ "$STATE" != "in shutdown" ] || { echo "vm_must_be_stopped" >&2; exit 4; }
    exec /usr/bin/virsh undefine "$VM" --nvram
    ;;
  autostart-on) need_vm; exec /usr/bin/virsh autostart "$VM" ;;
  autostart-off) need_vm; exec /usr/bin/virsh autostart --disable "$VM" ;;
  *) echo "invalid_action" >&2; exit 2 ;;
esac
 || { echo "root_uuid_not_found" >&2; exit 8; }
    /usr/sbin/mkfs.ext4 -F -U "$ROOT_UUID" "${LOOP}p1" >/dev/null
    /usr/bin/mount "${LOOP}p1" "$TMP"; /usr/bin/gzip -dc "$DIR/rootfs.tar.gz" | /usr/bin/tar --numeric-owner --xattrs --acls -C "$TMP" -xpf -
    /usr/bin/umount "$TMP"
    if [ -b "${LOOP}p5" ]; then
      if printf '%s' "$SWAP_UUID" | /usr/bin/grep -Eq '^[0-9a-fA-F-]{36}
    ;;
  start) need_vm; exec /usr/bin/virsh start "$VM" ;;
  shutdown) need_vm; exec /usr/bin/virsh shutdown "$VM" ;;
  reboot) need_vm; exec /usr/bin/virsh reboot "$VM" ;;
  destroy) need_vm; exec /usr/bin/virsh destroy "$VM" ;;
  delete)
    need_vm
    STATE=$(/usr/bin/virsh domstate "$VM" 2>/dev/null || true)
    [ "$STATE" != "running" ] && [ "$STATE" != "paused" ] && [ "$STATE" != "in shutdown" ] || { echo "vm_must_be_stopped" >&2; exit 4; }
    exec /usr/bin/virsh undefine "$VM" --nvram
    ;;
  autostart-on) need_vm; exec /usr/bin/virsh autostart "$VM" ;;
  autostart-off) need_vm; exec /usr/bin/virsh autostart --disable "$VM" ;;
  *) echo "invalid_action" >&2; exit 2 ;;
esac
; then /usr/sbin/mkswap -U "$SWAP_UUID" "${LOOP}p5" >/dev/null
      else echo "swap_uuid_not_found" >&2; exit 9
      fi
    fi
    /usr/sbin/losetup -d "$LOOP"; LOOP=""; /usr/bin/sync; echo "restored:$ID"
    ;;
  start) need_vm; exec /usr/bin/virsh start "$VM" ;;
  shutdown) need_vm; exec /usr/bin/virsh shutdown "$VM" ;;
  reboot) need_vm; exec /usr/bin/virsh reboot "$VM" ;;
  destroy) need_vm; exec /usr/bin/virsh destroy "$VM" ;;
  delete)
    need_vm
    STATE=$(/usr/bin/virsh domstate "$VM" 2>/dev/null || true)
    [ "$STATE" != "running" ] && [ "$STATE" != "paused" ] && [ "$STATE" != "in shutdown" ] || { echo "vm_must_be_stopped" >&2; exit 4; }
    exec /usr/bin/virsh undefine "$VM" --nvram
    ;;
  autostart-on) need_vm; exec /usr/bin/virsh autostart "$VM" ;;
  autostart-off) need_vm; exec /usr/bin/virsh autostart --disable "$VM" ;;
  *) echo "invalid_action" >&2; exit 2 ;;
esac
